{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/engziyad/RASD-v1.0/schemas/tuning.schema.json",
  "title": "RASD Tuning Guide",
  "description": "How a detection may and may not be tuned. Applied tunings point at filters in rule.yml; proposed and rejected ones carry a filter that tools/tune.py measures (attack variants hidden vs corpus alerts removed).",
  "type": "object",
  "required": [
    "detection_id",
    "expected_noise",
    "noise_sources",
    "tunings",
    "never_tune",
    "review"
  ],
  "additionalProperties": false,
  "properties": {
    "detection_id": {
      "type": "string",
      "pattern": "^T\\d{4}(\\.\\d{3})?_[a-z0-9_]+$"
    },
    "expected_noise": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "noise_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "tunings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "status": {
            "enum": [
              "applied",
              "proposed",
              "rejected"
            ]
          },
          "kind": {
            "enum": [
              "filter",
              "exception"
            ]
          },
          "selection": {
            "type": "string",
            "description": "applied: the selection name in rule.yml"
          },
          "filter": {
            "type": "object",
            "minProperties": 1,
            "description": "proposed / rejected: a Sigma selection"
          },
          "scope": {
            "enum": [
              "global",
              "environment",
              "host"
            ]
          },
          "residual_risk": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 10
          },
          "alternative": {
            "type": "string"
          }
        }
      }
    },
    "never_tune": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "review": {
      "type": "object",
      "required": [
        "owner",
        "cadence_days"
      ],
      "properties": {
        "owner": {
          "type": "string"
        },
        "cadence_days": {
          "type": "integer",
          "minimum": 7
        }
      }
    }
  }
}
