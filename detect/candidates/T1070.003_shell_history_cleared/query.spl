index=linux sourcetype="sysmon:linux" EventID=1
| where (((match('Image', "(?i)/rm$") OR match('Image', "(?i)/shred$") OR match('Image', "(?i)/truncate$")) AND (match('CommandLine', "(?i)\\.bash_history") OR match('CommandLine', "(?i)\\.zsh_history"))) OR (match('Image', "(?i)/ln$") AND (match('CommandLine', "(?i)/dev/null") AND match('CommandLine', "(?i)_history"))) OR match('CommandLine', "(?i)history\\s+-c(\\s|;|&|\"|$)"))
