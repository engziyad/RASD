index=sysmon source="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1
| where ((match('ParentImage', "(?i)\\\\w3wp\\.exe$") OR match('ParentImage', "(?i)\\\\httpd\\.exe$") OR match('ParentImage', "(?i)\\\\nginx\\.exe$") OR match('ParentImage', "(?i)\\\\php\\-cgi\\.exe$") OR match('ParentImage', "(?i)\\\\tomcat9\\.exe$")) AND ((match('Image', "(?i)\\\\cmd\\.exe$") OR match('Image', "(?i)\\\\powershell\\.exe$") OR match('Image', "(?i)\\\\pwsh\\.exe$") OR match('Image', "(?i)\\\\cscript\\.exe$") OR match('Image', "(?i)\\\\wscript\\.exe$")) OR (lower('OriginalFileName')="cmd.exe" OR lower('OriginalFileName')="powershell.exe" OR lower('OriginalFileName')="pwsh.dll" OR lower('OriginalFileName')="cscript.exe" OR lower('OriginalFileName')="wscript.exe")))
