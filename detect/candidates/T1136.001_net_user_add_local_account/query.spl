index=sysmon source="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1
| where ((((match('Image', "(?i)\\\\net\\.exe$") OR match('Image', "(?i)\\\\net1\\.exe$")) OR (lower('OriginalFileName')="net.exe" OR lower('OriginalFileName')="net1.exe")) AND match('CommandLine', "(?i)\\susers?\\s") AND match('CommandLine', "(?i)\\s/add(\\s|$)")) AND NOT (match(coalesce('CommandLine', ""), "(?i)\\s/do[a-z]*(\\s|$)")))
