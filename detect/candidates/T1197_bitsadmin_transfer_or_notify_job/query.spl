index=sysmon source="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1
| where ((match('Image', "(?i)\\\\bitsadmin\\.exe$") OR lower('OriginalFileName')="bitsadmin.exe") AND (match('CommandLine', "(?i)transfer") OR match('CommandLine', "(?i)addfile") OR match('CommandLine', "(?i)setnotifycmdline")))
