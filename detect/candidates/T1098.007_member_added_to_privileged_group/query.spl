index=wineventlog source="XmlWinEventLog:Security"
| where (('EventCode'=4728 OR 'EventCode'=4732 OR 'EventCode'=4756) AND (lower('TargetUserName')="domain admins" OR lower('TargetUserName')="enterprise admins" OR lower('TargetUserName')="schema admins" OR lower('TargetUserName')="administrators" OR lower('TargetUserName')="backup operators" OR lower('TargetUserName')="account operators" OR lower('TargetUserName')="dnsadmins"))
