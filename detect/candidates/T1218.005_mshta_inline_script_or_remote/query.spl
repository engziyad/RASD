index=sysmon source="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1
| where ((match('Image', "(?i)\\\\mshta\\.exe$") OR lower('OriginalFileName')="mshta.exe") AND (match('CommandLine', "(?i)vbscript:") OR match('CommandLine', "(?i)javascript:") OR match('CommandLine', "(?i)http://") OR match('CommandLine', "(?i)https://")))
