// Mshta Running Inline Script or a Remote HTML Application | 207889c9-9b44-58df-ae87-61c2d071e96e
Sysmon
| where EventID == 1
| where ((Image endswith @"\mshta.exe" or OriginalFileName =~ @"MSHTA.EXE") and (CommandLine contains @"vbscript:" or CommandLine contains @"javascript:" or CommandLine contains @"http://" or CommandLine contains @"https://"))
