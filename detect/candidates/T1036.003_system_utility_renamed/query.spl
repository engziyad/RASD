index=sysmon source="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1
| where ((lower('OriginalFileName')="powershell.exe" OR lower('OriginalFileName')="cmd.exe" OR lower('OriginalFileName')="certutil.exe" OR lower('OriginalFileName')="rundll32.exe" OR lower('OriginalFileName')="mshta.exe" OR lower('OriginalFileName')="regsvr32.exe" OR lower('OriginalFileName')="wscript.exe" OR lower('OriginalFileName')="cscript.exe") AND NOT (match(coalesce('Image', ""), "(?i)\\\\powershell\\.exe$") OR match(coalesce('Image', ""), "(?i)\\\\cmd\\.exe$") OR match(coalesce('Image', ""), "(?i)\\\\certutil\\.exe$") OR match(coalesce('Image', ""), "(?i)\\\\rundll32\\.exe$") OR match(coalesce('Image', ""), "(?i)\\\\mshta\\.exe$") OR match(coalesce('Image', ""), "(?i)\\\\regsvr32\\.exe$") OR match(coalesce('Image', ""), "(?i)\\\\wscript\\.exe$") OR match(coalesce('Image', ""), "(?i)\\\\cscript\\.exe$")))
