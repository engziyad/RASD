index=linux sourcetype="sysmon:linux" EventID=1
| where ((match('Image', "(?i)/tee$") AND match('CommandLine', "(?i)authorized_keys")) OR ((match('Image', "(?i)/bash$") OR match('Image', "(?i)/sh$") OR match('Image', "(?i)/dash$") OR match('Image', "(?i)/zsh$")) AND match('CommandLine', "(?i)>>\\s*\\S*authorized_keys")))
