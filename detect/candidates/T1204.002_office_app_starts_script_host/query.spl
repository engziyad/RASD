index=sysmon source="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1
| where ((match('ParentImage', "(?i)\\\\winword\\.exe$") OR match('ParentImage', "(?i)\\\\excel\\.exe$") OR match('ParentImage', "(?i)\\\\powerpnt\\.exe$") OR match('ParentImage', "(?i)\\\\outlook\\.exe$")) AND ((match('Image', "(?i)\\\\cmd\\.exe$") OR match('Image', "(?i)\\\\powershell\\.exe$") OR match('Image', "(?i)\\\\wscript\\.exe$") OR match('Image', "(?i)\\\\cscript\\.exe$") OR match('Image', "(?i)\\\\mshta\\.exe$")) OR (lower('OriginalFileName')="cmd.exe" OR lower('OriginalFileName')="powershell.exe" OR lower('OriginalFileName')="wscript.exe" OR lower('OriginalFileName')="cscript.exe" OR lower('OriginalFileName')="mshta.exe")))
