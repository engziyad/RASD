index=sysmon source="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1
| where ((match('Image', "(?i)\\\\regsvr32\\.exe$") OR lower('OriginalFileName')="regsvr32.exe") AND (match('CommandLine', "(?i)scrobj") OR match('CommandLine', "(?i)i:http") OR match('CommandLine', "(?i)i:ftp")))
