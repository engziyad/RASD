// Scheduled Task Created With Suspicious Action | 2114b226-991c-4830-9b80-8f5421283af3 | Microsoft Defender XDR advanced hunting
DeviceProcessEvents
| extend Image = iff(isempty(FolderPath), FileName, iff(isempty(FileName) or trim_end(@"[\\/]+", FolderPath) endswith FileName, FolderPath, strcat(trim_end(@"[\\/]+", FolderPath), @"\", FileName))),
    OriginalFileName = tostring(ProcessVersionInfoOriginalFileName),
    CommandLine = tostring(ProcessCommandLine)
| where ((Image endswith @"\schtasks.exe" or OriginalFileName =~ @"schtasks.exe") and CommandLine matches regex @"(?i)(^|\s)""?[/-](create|change)""?(\s|$)" and ((CommandLine contains @"%TEMP%" or CommandLine contains @"%APPDATA%" or CommandLine contains @"powershell" or CommandLine contains @"pwsh" or CommandLine contains @"rundll32" or CommandLine contains @"certutil" or CommandLine contains @"bitsadmin" or CommandLine contains @"cmd /c" or CommandLine contains @"cmd.exe /c" or CommandLine contains @"mshta" or CommandLine contains @"wscript" or CommandLine contains @"cscript" or CommandLine contains @"regsvr32" or CommandLine contains @"http://" or CommandLine contains @"https://") or CommandLine matches regex @"(?i)[\\/](AppData|ProgramData|Users[\\/]Public|Windows[\\/]Temp|Downloads)[\\/]" or (CommandLine matches regex @"(?i)(^|\s)[/-]s\s+\S+" and CommandLine matches regex @"(?i)(^|\s)[/-]ru\s+""?(nt authority\\system|system)""?(\s|$)")))
