// Run Key Persistence Pointing to Suspicious Location | cd7aa717-e694-4271-889f-019a448ef63b | Microsoft Defender XDR advanced hunting
DeviceRegistryEvents
| where ActionType == "RegistryValueSet"
| extend TargetObject = strcat(replace_regex(replace_regex(replace_regex(RegistryKey, @"(?i)^HKEY_LOCAL_MACHINE", "HKLM"), @"(?i)^HKEY_(CURRENT_USER|USERS)", "HKU"), @"(?i)^HKEY_CLASSES_ROOT", "HKCR"), @"\", iff(isempty(RegistryValueName), "(Default)", RegistryValueName)),
    Details = tostring(RegistryValueData)
| where ((TargetObject contains @"\Software\Microsoft\Windows\CurrentVersion\Run\" or TargetObject contains @"\Software\Microsoft\Windows\CurrentVersion\RunOnce\" or TargetObject contains @"\Software\WOW6432Node\Microsoft\Windows\CurrentVersion\Run\" or TargetObject contains @"\Software\WOW6432Node\Microsoft\Windows\CurrentVersion\RunOnce\") and ((Details contains @"powershell" or Details contains @"pwsh" or Details contains @"mshta" or Details contains @"wscript" or Details contains @"cscript" or Details contains @"rundll32" or Details contains @"regsvr32" or Details contains @"cmd /c" or Details contains @"cmd.exe /c") or Details matches regex @"(?i)[\\/](AppData|ProgramData|Users[\\/]Public|Windows[\\/](Temp|Tasks)|Downloads)[\\/]" or Details matches regex @"(?i)%(TEMP|TMP|APPDATA|LOCALAPPDATA|PUBLIC|PROGRAMDATA)%" or Details matches regex @"(?i)[\\/]Users[\\/][^\\/""]+[\\/][^\\/""]+\.(exe|dll|scr|bat|cmd|ps1|vbs|js|hta)\b") and not((Details matches regex @"(?i)^""?[a-z]:\\Users\\[^\\""]+\\AppData\\Local\\Microsoft\\OneDrive\\OneDrive\.exe""?( /background)?$" or Details matches regex @"(?i)^""?[a-z]:\\Users\\[^\\""]+\\AppData\\Local\\Microsoft\\Teams\\Update\.exe""? --processStart ""?Teams\.exe""?( --process-start-args ""--system-initiated"")?$")))
