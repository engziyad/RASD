// Suspicious Child Process of a WinRM Session Host | 0476861f-29f4-4dd1-a9e4-d16679efcb74 | Microsoft Defender XDR advanced hunting
DeviceProcessEvents
| extend ParentImage = iff(isempty(InitiatingProcessFolderPath), InitiatingProcessFileName, iff(isempty(InitiatingProcessFileName) or trim_end(@"[\\/]+", InitiatingProcessFolderPath) endswith InitiatingProcessFileName, InitiatingProcessFolderPath, strcat(trim_end(@"[\\/]+", InitiatingProcessFolderPath), @"\", InitiatingProcessFileName))),
    Image = iff(isempty(FolderPath), FileName, iff(isempty(FileName) or trim_end(@"[\\/]+", FolderPath) endswith FileName, FolderPath, strcat(trim_end(@"[\\/]+", FolderPath), @"\", FileName))),
    OriginalFileName = tostring(ProcessVersionInfoOriginalFileName),
    CommandLine = tostring(ProcessCommandLine)
| where ((ParentImage endswith @"\wsmprovhost.exe" or ParentImage endswith @"\winrshost.exe") and ((Image endswith @"\cmd.exe" or OriginalFileName =~ @"Cmd.Exe") or ((Image endswith @"\rundll32.exe" or Image endswith @"\regsvr32.exe" or Image endswith @"\mshta.exe" or Image endswith @"\certutil.exe" or Image endswith @"\bitsadmin.exe") or (OriginalFileName =~ @"RUNDLL32.EXE" or OriginalFileName =~ @"REGSVR32.EXE" or OriginalFileName =~ @"MSHTA.EXE" or OriginalFileName =~ @"CertUtil.exe" or OriginalFileName =~ @"bitsadmin.exe")) or (((Image endswith @"\powershell.exe" or Image endswith @"\pwsh.exe") or (OriginalFileName =~ @"PowerShell.EXE" or OriginalFileName =~ @"pwsh.dll")) and CommandLine matches regex @"(?i)\s""*[-/–—―][-–—―]?""*e(c|n(c(o(d(e(d(c(o(m(m(a(n(d)?)?)?)?)?)?)?)?)?)?)?)?)?""*\s+""*[A-Za-z0-9+/]{16,}={0,2}")))
