index=wineventlog source="XmlWinEventLog:System"
| where ((lower('Provider_Name')="service control manager" AND 'EventCode'=7045) AND ((match('ImagePath', "(?i)%COMSPEC%") OR match('ImagePath', "(?i)cmd\\.exe\\ /c") OR match('ImagePath', "(?i)cmd\\ /c") OR match('ImagePath', "(?i)cmd\\.exe\\ /Q\\ /c") OR match('ImagePath', "(?i)powershell") OR match('ImagePath', "(?i)\\\\ADMIN\\$\\\\") OR match('ImagePath', "(?i)\\\\\\\\127\\.0\\.0\\.1\\\\")) OR match('ImagePath', "(?i)[\\\\/](AppData|Users[\\\\/]Public|Windows[\\\\/]Temp|Downloads)[\\\\/]") OR match('ImagePath', "(?i)\\.(bat|cmd)\\b") OR (match('ServiceName', "(?i)^PSEXESVC") OR match('ServiceName', "(?i)^PAExec") OR match('ServiceName', "(?i)^RemComSvc") OR match('ServiceName', "(?i)^csexecsvc") OR match('ServiceName', "(?i)^BTOBTO")) OR match('ImagePath', "(?i)^(%SystemRoot%|[A-Za-z]:\\\\Windows)\\\\[A-Za-z]{8}\\.exe$")))
