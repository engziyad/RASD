index=sysmon source="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=10
| where (match('TargetImage', "(?i)\\\\lsass\\.exe$") AND (match('GrantedAccess', "(?i)^0x[0-9a-f]*[13579bdf][0-9a-f]$") OR (lower('GrantedAccess')="16" OR lower('GrantedAccess')="4112" OR lower('GrantedAccess')="5136" OR lower('GrantedAccess')="5176" OR lower('GrantedAccess')="5178" OR lower('GrantedAccess')="2097151" OR lower('GrantedAccess')="2039807" OR lower('GrantedAccess')="2047999")) AND NOT ((lower(coalesce('SourceImage', ""))="c:\\windows\\system32\\csrss.exe" OR lower(coalesce('SourceImage', ""))="c:\\windows\\system32\\wininit.exe" OR lower(coalesce('SourceImage', ""))="c:\\windows\\system32\\wbem\\wmiprvse.exe" OR lower(coalesce('SourceImage', ""))="c:\\windows\\syswow64\\wbem\\wmiprvse.exe") OR ((lower(coalesce('SourceImage', ""))="c:\\windows\\system32\\windowspowershell\\v1.0\\powershell.exe" OR lower(coalesce('SourceImage', ""))="c:\\windows\\system32\\wsmprovhost.exe") AND (lower(coalesce('GrantedAccess', ""))="0x1410" OR lower(coalesce('GrantedAccess', ""))="5136") AND match(coalesce('CallTrace', ""), "(?i)\\\\System\\.ni\\.dll\\+")) OR (match(coalesce('SourceImage', ""), "(?i)^C:\\\\ProgramData\\\\Microsoft\\\\Windows\\ Defender\\\\Platform\\\\") AND match(coalesce('SourceImage', ""), "(?i)\\\\MsMpEng\\.exe$"))))
