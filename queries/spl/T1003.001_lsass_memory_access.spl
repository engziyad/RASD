index=sysmon source="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=10
| where ((match('TargetImage', "(?i)\\\\lsass\\.exe$") AND (lower('GrantedAccess')="0x1010" OR lower('GrantedAccess')="0x1410" OR lower('GrantedAccess')="0x1438" OR lower('GrantedAccess')="0x143a" OR lower('GrantedAccess')="0x1fffff" OR lower('GrantedAccess')="4112" OR lower('GrantedAccess')="5136" OR lower('GrantedAccess')="5176" OR lower('GrantedAccess')="5178" OR lower('GrantedAccess')="2097151")) AND (NOT ((match(coalesce('SourceImage', ""), "(?i)^C:\\\\Windows\\\\System32\\\\") OR match(coalesce('SourceImage', ""), "(?i)^C:\\\\Windows\\\\SysWOW64\\\\")) OR (match(coalesce('SourceImage', ""), "(?i)^C:\\\\ProgramData\\\\Microsoft\\\\Windows\\ Defender\\\\Platform\\\\") AND match(coalesce('SourceImage', ""), "(?i)\\\\MsMpEng\\.exe$"))) OR (match('SourceImage', "(?i)\\\\rundll32\\.exe$") OR match('SourceImage', "(?i)\\\\taskmgr\\.exe$"))))
