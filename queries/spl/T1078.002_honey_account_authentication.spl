index=wineventlog source="XmlWinEventLog:Security"
| where (('EventCode'=4624 OR 'EventCode'=4625 OR 'EventCode'=4768 OR 'EventCode'=4771 OR 'EventCode'=4776) AND (lower('TargetUserName')="svc_backup_adm" OR match('TargetUserName', "(?i)^svc_backup_adm@.*$") OR lower('TargetUserName')="adm_helpdesk_tier2" OR match('TargetUserName', "(?i)^adm_helpdesk_tier2@.*$")))
