index=sysmon source="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1
| where (((match('Image', "(?i)\\\\powershell\\.exe$") OR match('Image', "(?i)\\\\pwsh\\.exe$")) OR (lower('OriginalFileName')="powershell.exe" OR lower('OriginalFileName')="pwsh.dll")) AND (match('CommandLine', "(?i)Register\\-ScheduledTask") OR match('CommandLine', "(?i)Set\\-ScheduledTask")) AND (match('CommandLine', "(?i)New\\-ScheduledTaskAction") OR (match('CommandLine', "(?i)\\$env:TEMP") OR match('CommandLine', "(?i)\\$env:APPDATA") OR match('CommandLine', "(?i)http://") OR match('CommandLine', "(?i)https://")) OR match('CommandLine', "(?i)[\\\\/](AppData|ProgramData|Users[\\\\/]Public|Windows[\\\\/]Temp|Downloads)[\\\\/]")))
