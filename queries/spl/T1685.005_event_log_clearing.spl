index=sysmon source="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1
| where (((match('Image', "(?i)\\\\wevtutil\\.exe$") OR lower('OriginalFileName')="wevtutil.exe") AND match('CommandLine', "(?i)\\s\"?(cl|clear-log)\"?(\\s|$)")) OR (((match('Image', "(?i)\\\\powershell\\.exe$") OR match('Image', "(?i)\\\\pwsh\\.exe$")) OR (lower('OriginalFileName')="powershell.exe" OR lower('OriginalFileName')="pwsh.dll")) AND (match('CommandLine', "(?i)Clear\\-EventLog") OR match('CommandLine', "(?i)Remove\\-EventLog") OR match('CommandLine', "(?i)Limit\\-EventLog") OR match('CommandLine', "(?i)\\.ClearLog\\("))) OR match('CommandLine', "(?i)cleareventlog"))
