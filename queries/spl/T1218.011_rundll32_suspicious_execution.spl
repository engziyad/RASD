index=sysmon source="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1
| where ((match('Image', "(?i)\\\\rundll32\\.exe$") OR lower('OriginalFileName')="rundll32.exe") AND ((match('CommandLine', "(?i)javascript:") OR match('CommandLine', "(?i)vbscript:") OR match('CommandLine', "(?i)RunHTMLApplication")) OR match('CommandLine', "(?i)[\\\\/](AppData|ProgramData|Users[\\\\/]Public|Windows[\\\\/]Temp|Downloads)[\\\\/]") OR (match('CommandLine', "(?i)comsvcs") AND match('CommandLine', "(?i)(minidump|#\\+?0*(24|65560)\\b|#-4294967272\\b)")) OR match('CommandLine', "(?i)rundll32(\\.exe)?\"?\\s*$") OR match('CommandLine', "(?i)\\b(zipfldr(\\.dll)?\"?[\\s,]+\"?RouteTheCall|advpack(\\.dll)?\"?[\\s,]+\"?RegisterOCX|pcwutl(\\.dll)?\"?[\\s,]+\"?LaunchApplication)\\b") OR match('CommandLine', "(?i)\\b(shell32(\\.dll)?\"?[\\s,]+\"?ShellExec_RunDLL[AW]?|url(\\.dll)?\"?[\\s,]+\"?(FileProtocolHandler|OpenURL))\\b") OR match('CommandLine', "(?i)rundll32(\\.exe)?\"?[\\s,]+\"?\\\\\\\\[^\\\\\\s\"]+\\\\") OR match('CommandLine', "(?i)[\\\\/]Users[\\\\/][^\\\\/\"]+[\\\\/][^\\\\/\",]+\\.(dll|cpl|ocx)\\b")))
