index=deception sourcetype=opencanary
| where ((lower('node_id')="lab-canary-01" AND ('logtype'=2000 OR 'logtype'=2001 OR 'logtype'=3000 OR 'logtype'=3001 OR 'logtype'=3002 OR 'logtype'=3003 OR 'logtype'=4000 OR 'logtype'=4001 OR 'logtype'=4002 OR 'logtype'=5000 OR 'logtype'=5001 OR 'logtype'=5002 OR 'logtype'=5003 OR 'logtype'=5004 OR 'logtype'=5005 OR 'logtype'=6001 OR 'logtype'=6002 OR 'logtype'=9001 OR 'logtype'=9002 OR 'logtype'=12001 OR 'logtype'=14001)) AND NOT (lower(coalesce('src_host', ""))="10.0.0.9" OR (lower(coalesce('src_host', ""))="127.0.0.1" OR lower(coalesce('src_host', ""))="::1")))
