index=wineventlog source="XmlWinEventLog:Security"
| where (('EventCode'=4769 AND (lower('TicketEncryptionType')="0x17" OR lower('TicketEncryptionType')="23" OR lower('TicketEncryptionType')="0x18" OR lower('TicketEncryptionType')="24" OR lower('TicketEncryptionType')="0x1" OR lower('TicketEncryptionType')="1" OR lower('TicketEncryptionType')="0x3" OR lower('TicketEncryptionType')="3") AND (lower('Status')="0x0" OR lower('Status')="0")) AND NOT (match(coalesce('ServiceName', ""), "(?i)\\$$") OR lower(coalesce('ServiceName', ""))="krbtgt" OR (lower(coalesce('IpAddress', ""))="::1" OR lower(coalesce('IpAddress', ""))="127.0.0.1" OR lower(coalesce('IpAddress', ""))="::ffff:127.0.0.1")))
