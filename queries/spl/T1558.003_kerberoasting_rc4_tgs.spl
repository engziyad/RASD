index=wineventlog source="XmlWinEventLog:Security"
| where (('EventCode'=4769 AND (lower('TicketEncryptionType')="0x17" OR lower('TicketEncryptionType')="23") AND (lower('Status')="0x0" OR lower('Status')="0")) AND NOT (match(coalesce('ServiceName', ""), "(?i)\\$$") OR lower(coalesce('ServiceName', ""))="krbtgt" OR lower(coalesce('IpAddress', ""))="::1"))
