index=wineventlog source="XmlWinEventLog:Security"
| where (('EventCode'=4663 AND lower('ObjectType')="file" AND (match('ObjectName', "(?i)\\\\IT\\\\Passwords\\\\service_accounts\\.xlsx$") OR match('ObjectName', "(?i)\\\\IT\\\\Tools\\\\credentials_backup\\.kdbx$") OR match('ObjectName', "(?i)\\\\Public\\\\Onboarding\\\\vpn_and_wifi_codes\\.txt$")) AND (match('AccessList', "(?i)%%4416") OR match('AccessList', "(?i)%%4417") OR match('AccessList', "(?i)%%4418") OR match('AccessList', "(?i)%%1537"))) AND NOT (match(coalesce('SubjectUserName', ""), "(?i)\\$$") OR (match(coalesce('ProcessName', ""), "(?i)\\\\SearchProtocolHost\\.exe$") OR match(coalesce('ProcessName', ""), "(?i)\\\\SearchIndexer\\.exe$"))))
