index=sysmon source="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1
| where ((match('Image', "(?i)\\\\schtasks\\.exe$") OR lower('OriginalFileName')="schtasks.exe") AND match('CommandLine', "(?i)(^|\\s)\"?[/-](create|change)\"?(\\s|$)") AND ((match('CommandLine', "(?i)%TEMP%") OR match('CommandLine', "(?i)%APPDATA%") OR match('CommandLine', "(?i)powershell") OR match('CommandLine', "(?i)cmd\\ /c") OR match('CommandLine', "(?i)cmd\\.exe\\ /c") OR match('CommandLine', "(?i)mshta") OR match('CommandLine', "(?i)wscript") OR match('CommandLine', "(?i)cscript") OR match('CommandLine', "(?i)regsvr32") OR match('CommandLine', "(?i)http://") OR match('CommandLine', "(?i)https://")) OR match('CommandLine', "(?i)[\\\\/](AppData|ProgramData|Users[\\\\/]Public|Windows[\\\\/]Temp|Downloads)[\\\\/]") OR (match('CommandLine', "(?i)(^|\\s)[/-]s\\s+\\S+") AND match('CommandLine', "(?i)(^|\\s)[/-]ru\\s+\"?(nt authority\\\\system|system)\"?(\\s|$)"))))
