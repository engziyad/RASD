index=sysmon source="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1
| where ((match('ParentImage', "(?i)\\\\wsmprovhost\\.exe$") OR match('ParentImage', "(?i)\\\\winrshost\\.exe$")) AND ((match('Image', "(?i)\\\\cmd\\.exe$") OR lower('OriginalFileName')="cmd.exe") OR ((match('Image', "(?i)\\\\rundll32\\.exe$") OR match('Image', "(?i)\\\\regsvr32\\.exe$") OR match('Image', "(?i)\\\\mshta\\.exe$") OR match('Image', "(?i)\\\\certutil\\.exe$") OR match('Image', "(?i)\\\\bitsadmin\\.exe$")) OR (lower('OriginalFileName')="rundll32.exe" OR lower('OriginalFileName')="regsvr32.exe" OR lower('OriginalFileName')="mshta.exe" OR lower('OriginalFileName')="certutil.exe" OR lower('OriginalFileName')="bitsadmin.exe")) OR (((match('Image', "(?i)\\\\powershell\\.exe$") OR match('Image', "(?i)\\\\pwsh\\.exe$")) OR (lower('OriginalFileName')="powershell.exe" OR lower('OriginalFileName')="pwsh.dll")) AND match('CommandLine', "(?i)\\s\"*[-/–—―][-–—―]?\"*e(c|n(c(o(d(e(d(c(o(m(m(a(n(d)?)?)?)?)?)?)?)?)?)?)?)?)?\"*\\s+\"*[A-Za-z0-9+/]{16,}={0,2}"))))
