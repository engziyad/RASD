index=web sourcetype=access_combined
| where ((lower('status')="401" OR lower('status')="403") AND NOT (lower(coalesce('method', ""))="options"))
| where isnotnull('clientip') AND 'clientip'!="" AND isnotnull('uri_path') AND 'uri_path'!=""
| bin span=300s _time AS window_start
| stats dc(uri_path) as value_count count as event_count values(uri_path) as distinct_values min(_time) as first_event max(_time) as last_event by window_start clientip
| where value_count>=5
