index=wineventlog source="XmlWinEventLog:Security"
| where ((('EventCode'=4771 AND (lower('Status')="0x18" OR lower('Status')="24")) OR ('EventCode'=4768 AND (lower('Status')="0x6" OR lower('Status')="6" OR lower('Status')="0x12" OR lower('Status')="18")) OR ('EventCode'=4625 AND (lower('SubStatus')="0xc000006a" OR lower('SubStatus')="3221225578" OR lower('SubStatus')="0xc0000064" OR lower('SubStatus')="3221225572"))) AND NOT (match(coalesce('TargetUserName', ""), "(?i)\\$$") OR (lower(coalesce('IpAddress', ""))="-" OR lower(coalesce('IpAddress', ""))="::1" OR lower(coalesce('IpAddress', ""))="127.0.0.1" OR lower(coalesce('IpAddress', ""))="::ffff:127.0.0.1")))
| eval IpAddress=replace('IpAddress', "^::ffff:", "")
| where isnotnull('IpAddress') AND 'IpAddress'!="" AND isnotnull('TargetUserName') AND 'TargetUserName'!=""
| bin span=600s _time AS window_start
| stats dc(TargetUserName) as value_count count as event_count values(TargetUserName) as distinct_values min(_time) as first_event max(_time) as last_event by window_start IpAddress
| where value_count>=5
