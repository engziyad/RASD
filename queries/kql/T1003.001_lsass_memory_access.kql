// Suspicious Process Access to LSASS Memory | 2a0b1b0e-af2b-4426-a58b-72866042c48c
Sysmon
| where EventID == 10
| where (TargetImage endswith @"\lsass.exe" and (GrantedAccess matches regex @"(?i)^0x[0-9a-f]*[13579bdf][0-9a-f]$" or (GrantedAccess =~ @"16" or GrantedAccess =~ @"4112" or GrantedAccess =~ @"5136" or GrantedAccess =~ @"5176" or GrantedAccess =~ @"5178" or GrantedAccess =~ @"2097151" or GrantedAccess =~ @"2039807" or GrantedAccess =~ @"2047999")) and not(((SourceImage =~ @"C:\Windows\System32\csrss.exe" or SourceImage =~ @"C:\Windows\System32\wininit.exe" or SourceImage =~ @"C:\Windows\System32\wbem\WmiPrvSE.exe" or SourceImage =~ @"C:\Windows\SysWOW64\wbem\WmiPrvSE.exe") or ((SourceImage =~ @"C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe" or SourceImage =~ @"C:\Windows\System32\wsmprovhost.exe") and (GrantedAccess =~ @"0x1410" or GrantedAccess =~ @"5136") and CallTrace contains @"\System.ni.dll+") or (SourceImage startswith @"C:\ProgramData\Microsoft\Windows Defender\Platform\" and SourceImage endswith @"\MsMpEng.exe") or (SourceImage =~ @"C:\Program Files\Splunk\bin\splunkd.exe" and SourceUser =~ @"NT SERVICE\Splunkd" and (GrantedAccess =~ @"0x1fffff" or GrantedAccess =~ @"2097151") and CallTrace matches regex @"(?i)^C:\\Windows\\System32\\ntdll\.dll\+[0-9a-f]+\|C:\\Windows\\System32\\KERNELBASE\.dll\+[0-9a-f]+(?:\|C:\\Program Files\\Splunk\\bin\\splunkd\.exe\+[0-9a-f]+)+\|C:\\Windows\\System32\\ucrtbase\.dll\+[0-9a-f]+\|C:\\Windows\\System32\\KERNEL32\.DLL\+[0-9a-f]+\|C:\\Windows\\System32\\ntdll\.dll\+[0-9a-f]+$"))))
