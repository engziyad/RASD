// Password Spray - One Source Failing Authentication for Many Accounts | f5f349c4-de03-46b4-a439-2884a1b1133b
// counts: Authentication Failure With a Wrong Password | 2e32a46d-cb7c-4dca-831e-09f3e1abe585
SecurityEvent
| extend Status = coalesce(tostring(column_ifexists("Status", "")), extract(@'Name="Status">([^<]*)<', 1, EventData))
| extend SubStatus = coalesce(tostring(column_ifexists("SubStatus", "")), extract(@'Name="SubStatus">([^<]*)<', 1, EventData))
| extend TargetUserName = coalesce(tostring(column_ifexists("TargetUserName", "")), extract(@'Name="TargetUserName">([^<]*)<', 1, EventData))
| extend IpAddress = coalesce(tostring(column_ifexists("IpAddress", "")), extract(@'Name="IpAddress">([^<]*)<', 1, EventData))
| where (((EventID == 4771 and (Status =~ @"0x18" or Status =~ @"24")) or (EventID == 4625 and (SubStatus =~ @"0xc000006a" or SubStatus =~ @"3221225578"))) and not((TargetUserName endswith @"$" or (IpAddress =~ @"-" or IpAddress =~ @"::1" or IpAddress =~ @"127.0.0.1" or IpAddress =~ @"::ffff:127.0.0.1"))))
| extend IpAddress = replace_regex(IpAddress, @"^::ffff:", "")
| where isnotempty(IpAddress) and isnotempty(TargetUserName)
| summarize value_count = array_length(make_set(TargetUserName)), event_count = count(), distinct_values = make_set(TargetUserName, 50), first_event = min(TimeGenerated), last_event = max(TimeGenerated) by window_start = bin(TimeGenerated, 600s), IpAddress
| where value_count >= 5
