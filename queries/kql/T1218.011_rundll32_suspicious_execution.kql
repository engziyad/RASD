// Rundll32 Proxy Execution From Suspicious Context | 7bc31caf-8287-4c8e-9936-381e4ab88410
Sysmon
| where EventID == 1
| where ((Image endswith @"\rundll32.exe" or OriginalFileName =~ @"RUNDLL32.EXE") and ((CommandLine contains @"javascript:" or CommandLine contains @"vbscript:" or CommandLine contains @"RunHTMLApplication") or CommandLine matches regex @"(?i)[\\/](AppData|ProgramData|Users[\\/]Public|Windows[\\/]Temp|Downloads)[\\/]" or (CommandLine contains @"comsvcs" and CommandLine matches regex @"(?i)(minidump|#\+?0*(24|65560)\b|#-4294967272\b)") or CommandLine matches regex @"(?i)rundll32(\.exe)?""?\s*$" or CommandLine matches regex @"(?i)\b(zipfldr(\.dll)?""?[\s,]+""?RouteTheCall|advpack(\.dll)?""?[\s,]+""?RegisterOCX|pcwutl(\.dll)?""?[\s,]+""?LaunchApplication)\b"))
