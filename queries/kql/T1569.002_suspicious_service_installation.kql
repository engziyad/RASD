// Suspicious Service Installation (PsExec-style / Command Services) | c36a647e-caeb-4c7d-894f-8b5a3619a350
Event
| where EventLog == "System"
| extend ImagePath = coalesce(tostring(column_ifexists("ImagePath", "")), extract(@'Name="ImagePath">([^<]*)<', 1, EventData))
| extend ServiceName = coalesce(tostring(column_ifexists("ServiceName", "")), extract(@'Name="ServiceName">([^<]*)<', 1, EventData))
| where ((Source =~ @"Service Control Manager" and EventID == 7045) and ((ImagePath contains @"%COMSPEC%" or ImagePath contains @"powershell" or ImagePath contains @"\ADMIN$\" or ImagePath contains @"\127.0.0.1\") or ImagePath matches regex @"(?i)(^|[\\/""\s])cmd(\.exe)?(""|\s|$)" or ImagePath matches regex @"(?i)[\\/](AppData|Users[\\/]Public|Temp|Downloads)[\\/]" or ImagePath matches regex @"(?i)\.(bat|cmd)\b" or (ServiceName startswith @"PSEXESVC" or ServiceName startswith @"PAExec" or ServiceName startswith @"RemComSvc" or ServiceName startswith @"csexecsvc" or ServiceName startswith @"BTOBTO") or ImagePath matches regex @"(?i)^(%SystemRoot%|[A-Za-z]:\\Windows)\\[A-Za-z]{8}\.exe$"))
