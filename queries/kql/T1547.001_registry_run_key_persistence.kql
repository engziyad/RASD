// Run Key Persistence Pointing to Suspicious Location | cd7aa717-e694-4271-889f-019a448ef63b
Sysmon
| where EventID == 13
| where ((TargetObject contains @"\Software\Microsoft\Windows\CurrentVersion\Run\" or TargetObject contains @"\Software\Microsoft\Windows\CurrentVersion\RunOnce\" or TargetObject contains @"\Software\WOW6432Node\Microsoft\Windows\CurrentVersion\Run\") and ((Details contains @"powershell" or Details contains @"mshta" or Details contains @"wscript" or Details contains @"cscript" or Details contains @"rundll32" or Details contains @"regsvr32" or Details contains @"cmd /c" or Details contains @"cmd.exe /c") or Details matches regex @"(?i)[\\/](AppData|ProgramData|Users[\\/]Public|Windows[\\/]Temp|Downloads)[\\/]") and not((Details contains @"\AppData\Local\Microsoft\OneDrive\OneDrive.exe" or Details contains @"\AppData\Local\Microsoft\Teams\")))
