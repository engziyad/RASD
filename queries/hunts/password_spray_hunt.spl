index=wineventlog source="XmlWinEventLog:Security" ((EventCode=4771 Status=0x18) OR (EventCode=4768 (Status=0x6 OR Status=0x12)) OR (EventCode=4776 (Status=0xc000006a OR Status=0xc0000064))) TargetUserName!="*$"
| eval Protocol=if(EventCode=4776, "NTLM", "Kerberos"), Source=if(EventCode=4776, Workstation, replace(IpAddress, "^::ffff:", ""))
| bin _time span=10m
| stats dc(TargetUserName) AS accounts values(TargetUserName) AS sample min(_time) AS first_seen max(_time) AS last_seen BY _time, Source, Protocol
| where accounts >= 5
| sort - accounts
