// Password spray hunt: one source failing authentication for 5+ distinct accounts in 10 minutes
// 4771 = Kerberos pre-authentication failed (0x18 = wrong password), 4776 = NTLM validation (0xc000006a = wrong password)
let window = 10m;
let min_accounts = 5;
SecurityEvent
| where (EventID == 4771 and Status =~ "0x18")
     or (EventID == 4776 and Status =~ "0xc000006a")
| extend Source = iff(EventID == 4771, replace_string(IpAddress, "::ffff:", ""), Workstation)
| summarize accounts = dcount(TargetUserName), sample = make_set(TargetUserName, 20),
            first_seen = min(TimeGenerated), last_seen = max(TimeGenerated)
    by Source, EventID, bin(TimeGenerated, window)
| where accounts >= min_accounts
| order by accounts desc
