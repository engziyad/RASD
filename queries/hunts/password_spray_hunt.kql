// Password spray hunt: one source failing authentication for 5+ distinct accounts in 10 minutes
// Kerberos, by client address: 4771 pre-authentication failed (0x18 = wrong password) and 4768 TGT refused
// (0x6 = unknown account, 0x12 = disabled, expired or locked) - the correlation counts these too.
// NTLM validated by a domain controller, by workstation name: 4776 (0xc000006a = wrong password,
// 0xc0000064 = unknown account) - the correlation does not count these (public data: sprays run on the host itself).
let window = 10m;
let min_accounts = 5;
SecurityEvent
| where (EventID == 4771 and Status =~ "0x18")
     or (EventID == 4768 and Status in~ ("0x6", "0x12"))
     or (EventID == 4776 and Status in~ ("0xc000006a", "0xc0000064"))
| where not(TargetUserName endswith "$")
| extend Protocol = iff(EventID == 4776, "NTLM", "Kerberos"),
         Source = iff(EventID == 4776, Workstation, replace_string(IpAddress, "::ffff:", ""))
| summarize accounts = dcount(TargetUserName), sample = make_set(TargetUserName, 20),
            first_seen = min(TimeGenerated), last_seen = max(TimeGenerated)
    by Source, Protocol, bin(TimeGenerated, window)
| where accounts >= min_accounts
| order by accounts desc
