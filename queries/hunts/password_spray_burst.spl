index=wineventlog source="XmlWinEventLog:Security" ((EventCode=4771 Status=0x18) OR (EventCode=4776 Status=0xc000006a))
| eval Source=if(EventCode=4771, replace(IpAddress, "^::ffff:", ""), Workstation)
| bin _time span=10m
| stats dc(TargetUserName) AS accounts values(TargetUserName) AS sample min(_time) AS first_seen max(_time) AS last_seen BY _time, Source, EventCode
| where accounts >= 5
| sort - accounts
