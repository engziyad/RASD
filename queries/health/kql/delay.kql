// RASD-Health · delay: Events indexed in the last hour arrived later than the scheduled searches wait.
union
  (Event | where Source == "Microsoft-Windows-Sysmon" | where TimeGenerated > ago(8d) and ingestion_time() > ago(1h) | project carrier = "Sysmon", host_ = tostring(Computer), lag = ingestion_time() - TimeGenerated),
  (SecurityEvent | where TimeGenerated > ago(8d) and ingestion_time() > ago(1h) | project carrier = "Security log", host_ = tostring(Computer), lag = ingestion_time() - TimeGenerated),
  (Event | where EventLog == "System" | where TimeGenerated > ago(8d) and ingestion_time() > ago(1h) | project carrier = "System log", host_ = tostring(Computer), lag = ingestion_time() - TimeGenerated),
  (Syslog | where ProcessName == "sysmon" | where TimeGenerated > ago(8d) and ingestion_time() > ago(1h) | project carrier = "Sysmon for Linux", host_ = tostring(Computer), lag = ingestion_time() - TimeGenerated),
  (W3CIISLog | where TimeGenerated > ago(8d) and ingestion_time() > ago(1h) | project carrier = "Web access log", host_ = tostring(Computer), lag = ingestion_time() - TimeGenerated)
| summarize events = count(), late = countif(lag > 5m), p95_lag = percentile(lag, 95) by carrier, host_
| extend late_pct = round(100.0 * late / events, 1)
| where late_pct >= 1
| extend blinds = case(carrier == "Sysmon", "T1003.001_lsass_memory_access, T1021.006_wsmprovhost_suspicious_child, T1053.005_powershell_scheduled_task_creation, T1053.005_schtasks_suspicious_creation, T1059.001_powershell_encoded_command, T1218.011_rundll32_suspicious_execution, T1547.001_registry_run_key_persistence, T1685.005_event_log_clearing", carrier == "Security log", "T1078.002_honey_account_authentication, T1110.003_password_spray_burst, T1552.001_honey_file_access, T1558.003_honey_spn_ticket_request, T1558.003_kerberoasting_rc4_tgs, T1558.003_kerberoasting_volume, T1685.005_security_log_cleared", carrier == "System log", "T1569.002_suspicious_service_installation, T1685.005_system_log_cleared", carrier == "Sysmon for Linux", "T1053.003_crontab_noninteractive_install, T1059.004_linux_suspicious_shell_execution", carrier == "Web access log", "T1190_object_id_enumeration, T1595.003_api_auth_probing", carrier == "Decoy records", "T1046_decoy_service_interaction", "")
| project carrier, host = host_, events, late, late_pct, p95_lag, blinds
