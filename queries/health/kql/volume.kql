// RASD-Health · volume: A host sent, in the last day, none or under a quarter of what it sent on the same day a week earlier, of an event the rules read.
union
  (SysmonForLinux | where EventID == 1 | where TimeGenerated > ago(24h) or TimeGenerated between (ago(8d) .. ago(7d)) | extend feed = "linux/process_creation", host_ = tostring(Computer) | project TimeGenerated, feed, host_),
  (OpenCanary | where TimeGenerated > ago(24h) or TimeGenerated between (ago(8d) .. ago(7d)) | extend feed = "opencanary/honeypot", host_ = tostring(node_id) | project TimeGenerated, feed, host_),
  (Sysmon | where EventID == 10 | where TimeGenerated > ago(24h) or TimeGenerated between (ago(8d) .. ago(7d)) | extend feed = "process_access", host_ = tostring(Computer) | project TimeGenerated, feed, host_),
  (Sysmon | where EventID == 1 | where TimeGenerated > ago(24h) or TimeGenerated between (ago(8d) .. ago(7d)) | extend feed = "process_creation", host_ = tostring(Computer) | project TimeGenerated, feed, host_),
  (Sysmon | where EventID == 13 | where TimeGenerated > ago(24h) or TimeGenerated between (ago(8d) .. ago(7d)) | extend feed = "registry_set", host_ = tostring(Computer) | project TimeGenerated, feed, host_),
  (W3CIISLog | where TimeGenerated > ago(24h) or TimeGenerated between (ago(8d) .. ago(7d)) | extend feed = "webserver", host_ = tostring(Computer) | project TimeGenerated, feed, host_),
  (SecurityEvent | where (TimeGenerated > ago(24h) or TimeGenerated between (ago(8d) .. ago(7d))) and EventID in (1102, 4624, 4625, 4663, 4768, 4769, 4771, 4776) | extend feed = strcat("windows/security#", tostring(EventID)), host_ = tostring(Computer) | project TimeGenerated, feed, host_),
  (Event | where EventLog == "System" | where (TimeGenerated > ago(24h) or TimeGenerated between (ago(8d) .. ago(7d))) and EventID in (104, 7045) | extend feed = strcat("windows/system#", tostring(EventID)), host_ = tostring(Computer) | project TimeGenerated, feed, host_)
| summarize last_24h = countif(TimeGenerated > ago(24h)), week_ago = countif(TimeGenerated <= ago(7d)) by feed, host_
| extend state = case(week_ago >= 20 and last_24h == 0, "silent", week_ago >= 50 and last_24h < 0.25 * week_ago, "volume fell", "")
| where isnotempty(state)
| extend blinds = case(feed == "linux/process_creation", "T1053.003_crontab_noninteractive_install, T1059.004_linux_suspicious_shell_execution", feed == "opencanary/honeypot", "T1046_decoy_service_interaction", feed == "process_access", "T1003.001_lsass_memory_access", feed == "process_creation", "T1021.006_wsmprovhost_suspicious_child, T1053.005_powershell_scheduled_task_creation, T1053.005_schtasks_suspicious_creation, T1059.001_powershell_encoded_command, T1218.011_rundll32_suspicious_execution, T1685.005_event_log_clearing", feed == "registry_set", "T1547.001_registry_run_key_persistence", feed == "webserver", "T1190_object_id_enumeration, T1595.003_api_auth_probing", feed == "windows/security#1102", "T1685.005_security_log_cleared", feed == "windows/security#4624", "T1078.002_honey_account_authentication", feed == "windows/security#4625", "T1078.002_honey_account_authentication, T1110.003_password_spray_burst", feed == "windows/security#4663", "T1552.001_honey_file_access", feed == "windows/security#4768", "T1078.002_honey_account_authentication, T1110.003_password_spray_burst", feed == "windows/security#4769", "T1558.003_honey_spn_ticket_request, T1558.003_kerberoasting_rc4_tgs, T1558.003_kerberoasting_volume", feed == "windows/security#4771", "T1078.002_honey_account_authentication, T1110.003_password_spray_burst", feed == "windows/security#4776", "T1078.002_honey_account_authentication", feed == "windows/system#104", "T1685.005_system_log_cleared", feed == "windows/system#7045", "T1569.002_suspicious_service_installation", "")
| project feed, host = host_, state, last_24h, week_ago, blinds
