// RASD-Health · fields: A field the rules read is filled in under 95% of the events that should carry it.
union
  (SysmonForLinux | where EventID == 1 | where TimeGenerated > ago(24h) | summarize events = count(), CommandLine_ = countif(isnotempty(CommandLine)), Image_ = countif(isnotempty(Image)) | project feed = "linux/process_creation", events, field = pack_array("CommandLine", "Image"), filled = pack_array(CommandLine_, Image_)),
  (OpenCanary | where TimeGenerated > ago(24h) | summarize events = count(), logtype_ = countif(isnotempty(logtype)), node_id_ = countif(isnotempty(node_id)), src_host_ = countif(isnotempty(src_host)) | project feed = "opencanary/honeypot", events, field = pack_array("logtype", "node_id", "src_host"), filled = pack_array(logtype_, node_id_, src_host_)),
  (Sysmon | where EventID == 10 | where TimeGenerated > ago(24h) | summarize events = count(), GrantedAccess_ = countif(isnotempty(GrantedAccess)), SourceImage_ = countif(isnotempty(SourceImage)), TargetImage_ = countif(isnotempty(TargetImage)) | project feed = "process_access", events, field = pack_array("GrantedAccess", "SourceImage", "TargetImage"), filled = pack_array(GrantedAccess_, SourceImage_, TargetImage_)),
  (Sysmon | where EventID == 1 | where TimeGenerated > ago(24h) | summarize events = count(), CommandLine_ = countif(isnotempty(CommandLine)), Image_ = countif(isnotempty(Image)), OriginalFileName_ = countif(isnotempty(OriginalFileName)), ParentImage_ = countif(isnotempty(ParentImage)) | project feed = "process_creation", events, field = pack_array("CommandLine", "Image", "OriginalFileName", "ParentImage"), filled = pack_array(CommandLine_, Image_, OriginalFileName_, ParentImage_)),
  (Sysmon | where EventID == 13 | where TimeGenerated > ago(24h) | summarize events = count(), Details_ = countif(isnotempty(Details)), TargetObject_ = countif(isnotempty(TargetObject)) | project feed = "registry_set", events, field = pack_array("Details", "TargetObject"), filled = pack_array(Details_, TargetObject_)),
  (W3CIISLog | where TimeGenerated > ago(24h) | summarize events = count(), cIP_ = countif(isnotempty(cIP)), csMethod_ = countif(isnotempty(csMethod)), csUriStem_ = countif(isnotempty(csUriStem)), scStatus_ = countif(isnotempty(scStatus)) | project feed = "webserver", events, field = pack_array("c-ip", "cs-method", "cs-uri-stem", "sc-status"), filled = pack_array(cIP_, csMethod_, csUriStem_, scStatus_)),
  (SecurityEvent | where TimeGenerated > ago(24h) and EventID in (1102, 4624, 4625, 4663, 4768, 4769, 4771, 4776) | extend AccessList = coalesce(tostring(column_ifexists("AccessList", "")), extract(@'Name="AccessList">([^<]*)<', 1, EventData)) | extend IpAddress = coalesce(tostring(column_ifexists("IpAddress", "")), extract(@'Name="IpAddress">([^<]*)<', 1, EventData)) | extend ObjectName = coalesce(tostring(column_ifexists("ObjectName", "")), extract(@'Name="ObjectName">([^<]*)<', 1, EventData)) | extend ObjectType = coalesce(tostring(column_ifexists("ObjectType", "")), extract(@'Name="ObjectType">([^<]*)<', 1, EventData)) | extend ProcessName = coalesce(tostring(column_ifexists("ProcessName", "")), extract(@'Name="ProcessName">([^<]*)<', 1, EventData)) | extend ServiceName = coalesce(tostring(column_ifexists("ServiceName", "")), extract(@'Name="ServiceName">([^<]*)<', 1, EventData)) | extend Status = coalesce(tostring(column_ifexists("Status", "")), extract(@'Name="Status">([^<]*)<', 1, EventData)) | extend SubStatus = coalesce(tostring(column_ifexists("SubStatus", "")), extract(@'Name="SubStatus">([^<]*)<', 1, EventData)) | extend SubjectUserName = coalesce(tostring(column_ifexists("SubjectUserName", "")), extract(@'Name="SubjectUserName">([^<]*)<', 1, EventData)) | extend TargetUserName = coalesce(tostring(column_ifexists("TargetUserName", "")), extract(@'Name="TargetUserName">([^<]*)<', 1, EventData)) | extend TicketEncryptionType = coalesce(tostring(column_ifexists("TicketEncryptionType", "")), extract(@'Name="TicketEncryptionType">([^<]*)<', 1, EventData)) | summarize events = count(), AccessList_ = countif(isnotempty(AccessList)), EventID_ = countif(isnotempty(EventID)), IpAddress_ = countif(isnotempty(IpAddress)), ObjectName_ = countif(isnotempty(ObjectName)), ObjectType_ = countif(isnotempty(ObjectType)), ProcessName_ = countif(isnotempty(ProcessName)), ServiceName_ = countif(isnotempty(ServiceName)), Status_ = countif(isnotempty(Status)), SubStatus_ = countif(isnotempty(SubStatus)), SubjectUserName_ = countif(isnotempty(SubjectUserName)), TargetUserName_ = countif(isnotempty(TargetUserName)), TicketEncryptionType_ = countif(isnotempty(TicketEncryptionType)) by EventID | project feed = strcat("windows/security#", tostring(EventID)), events, field = pack_array("AccessList", "EventID", "IpAddress", "ObjectName", "ObjectType", "ProcessName", "ServiceName", "Status", "SubStatus", "SubjectUserName", "TargetUserName", "TicketEncryptionType"), filled = pack_array(AccessList_, EventID_, IpAddress_, ObjectName_, ObjectType_, ProcessName_, ServiceName_, Status_, SubStatus_, SubjectUserName_, TargetUserName_, TicketEncryptionType_)),
  (Event | where EventLog == "System" | where TimeGenerated > ago(24h) and EventID in (104, 7045) | extend ImagePath = coalesce(tostring(column_ifexists("ImagePath", "")), extract(@'Name="ImagePath">([^<]*)<', 1, EventData)) | extend ServiceName = coalesce(tostring(column_ifexists("ServiceName", "")), extract(@'Name="ServiceName">([^<]*)<', 1, EventData)) | summarize events = count(), EventID_ = countif(isnotempty(EventID)), ImagePath_ = countif(isnotempty(ImagePath)), Source_ = countif(isnotempty(Source)), ServiceName_ = countif(isnotempty(ServiceName)) by EventID | project feed = strcat("windows/system#", tostring(EventID)), events, field = pack_array("EventID", "ImagePath", "Provider_Name", "ServiceName"), filled = pack_array(EventID_, ImagePath_, Source_, ServiceName_))
| mv-expand field to typeof(string), filled to typeof(long)
| extend reads = case(feed == "linux/process_creation", ",Image,CommandLine,", feed == "opencanary/honeypot", ",logtype,node_id,src_host,", feed == "process_access", ",TargetImage,SourceImage,GrantedAccess,", feed == "process_creation", ",ParentImage,Image,OriginalFileName,CommandLine,", feed == "registry_set", ",TargetObject,Details,", feed == "webserver", ",c-ip,cs-method,cs-uri-stem,sc-status,", feed == "windows/security#1102", ",EventID,", feed == "windows/security#4624", ",EventID,TargetUserName,", feed == "windows/security#4625", ",EventID,TargetUserName,SubStatus,IpAddress,", feed == "windows/security#4663", ",EventID,ObjectType,ObjectName,AccessList,SubjectUserName,ProcessName,", feed == "windows/security#4768", ",EventID,TargetUserName,Status,IpAddress,", feed == "windows/security#4769", ",EventID,ServiceName,TicketEncryptionType,Status,IpAddress,", feed == "windows/security#4771", ",EventID,TargetUserName,Status,IpAddress,", feed == "windows/security#4776", ",EventID,TargetUserName,", feed == "windows/system#104", ",EventID,Provider_Name,", feed == "windows/system#7045", ",EventID,Provider_Name,ServiceName,ImagePath,", "")
| where events > 0 and reads contains strcat(",", field, ",")
| extend coverage = round(100.0 * filled / events, 1)
| where coverage < 95
| extend blinds = case(feed == "linux/process_creation", "T1053.003_crontab_noninteractive_install, T1059.004_linux_suspicious_shell_execution", feed == "opencanary/honeypot", "T1046_decoy_service_interaction", feed == "process_access", "T1003.001_lsass_memory_access", feed == "process_creation", "T1021.006_wsmprovhost_suspicious_child, T1053.005_powershell_scheduled_task_creation, T1053.005_schtasks_suspicious_creation, T1059.001_powershell_encoded_command, T1218.011_rundll32_suspicious_execution, T1685.005_event_log_clearing", feed == "registry_set", "T1547.001_registry_run_key_persistence", feed == "webserver", "T1190_object_id_enumeration, T1595.003_api_auth_probing", feed == "windows/security#1102", "T1685.005_security_log_cleared", feed == "windows/security#4624", "T1078.002_honey_account_authentication", feed == "windows/security#4625", "T1078.002_honey_account_authentication, T1110.003_password_spray_burst", feed == "windows/security#4663", "T1552.001_honey_file_access", feed == "windows/security#4768", "T1078.002_honey_account_authentication, T1110.003_password_spray_burst", feed == "windows/security#4769", "T1558.003_honey_spn_ticket_request, T1558.003_kerberoasting_rc4_tgs, T1558.003_kerberoasting_volume", feed == "windows/security#4771", "T1078.002_honey_account_authentication, T1110.003_password_spray_burst", feed == "windows/security#4776", "T1078.002_honey_account_authentication", feed == "windows/system#104", "T1685.005_system_log_cleared", feed == "windows/system#7045", "T1569.002_suspicious_service_installation", "")
| project feed, field, coverage, events, blinds
