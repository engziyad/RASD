| tstats count where ((index=linux sourcetype="sysmon:linux") OR (index=deception sourcetype=opencanary) OR (index=sysmon source="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational") OR (index=web sourcetype=access_combined) OR (index=wineventlog source="XmlWinEventLog:Security") OR (index=wineventlog source="XmlWinEventLog:System")) earliest=-7d@h latest=@h by index, sourcetype, source, host, _time span=1h
| eval carrier=case(index=="linux" AND sourcetype=="sysmon:linux", "Sysmon for Linux", index=="deception" AND sourcetype=="opencanary", "Decoy records", index=="sysmon" AND source=="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational", "Sysmon", index=="web" AND sourcetype=="access_combined", "Web access log", index=="wineventlog" AND source=="XmlWinEventLog:Security", "Security log", index=="wineventlog" AND source=="XmlWinEventLog:System", "System log")
| where isnotnull(carrier)
| stats sum(count) as events by carrier, host, _time
| stats count as active_hours, max(_time) as last_hour, sum(events) as events_7d by carrier, host
| eval quiet_hours=round((relative_time(now(), "@h") - last_hour) / 3600) - 1
| where active_hours >= 84 AND quiet_hours >= 4
| eval last_seen=strftime(last_hour, "%Y-%m-%d %H:%M"), blinds=case(carrier=="Sysmon for Linux", "T1053.003_crontab_noninteractive_install, T1059.004_linux_suspicious_shell_execution", carrier=="Decoy records", "T1046_decoy_service_interaction", carrier=="Sysmon", "T1003.001_lsass_memory_access, T1021.006_wsmprovhost_suspicious_child, T1053.005_powershell_scheduled_task_creation, T1053.005_schtasks_suspicious_creation, T1059.001_powershell_encoded_command, T1218.011_rundll32_suspicious_execution, T1547.001_registry_run_key_persistence, T1685.005_event_log_clearing", carrier=="Web access log", "T1190_object_id_enumeration, T1595.003_api_auth_probing", carrier=="Security log", "T1078.002_honey_account_authentication, T1110.003_password_spray_burst, T1552.001_honey_file_access, T1558.003_honey_spn_ticket_request, T1558.003_kerberoasting_rc4_tgs, T1558.003_kerberoasting_volume, T1685.005_security_log_cleared", carrier=="System log", "T1569.002_suspicious_service_installation, T1685.005_system_log_cleared")
| table carrier, host, quiet_hours, last_seen, active_hours, events_7d, blinds
