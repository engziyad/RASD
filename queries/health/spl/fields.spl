| multisearch
    [search index=linux sourcetype="sysmon:linux" EventID=1 earliest=-24h latest=now | eval feed="linux/process_creation"]
    [search index=deception sourcetype=opencanary earliest=-24h latest=now | eval feed="opencanary/honeypot"]
    [search index=sysmon source="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=10 earliest=-24h latest=now | eval feed="process_access"]
    [search index=sysmon source="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=1 earliest=-24h latest=now | eval feed="process_creation"]
    [search index=sysmon source="XmlWinEventLog:Microsoft-Windows-Sysmon/Operational" EventCode=13 earliest=-24h latest=now | eval feed="registry_set"]
    [search index=web sourcetype=access_combined earliest=-24h latest=now | eval feed="webserver"]
    [search index=wineventlog source="XmlWinEventLog:Security" EventCode IN (1102, 4624, 4625, 4663, 4768, 4769, 4771, 4776) earliest=-24h latest=now | eval feed="windows/security#".EventCode]
    [search index=wineventlog source="XmlWinEventLog:System" EventCode IN (104, 7045) earliest=-24h latest=now | eval feed="windows/system#".EventCode]
| stats count as events, count(AccessList) as AccessList, count(CommandLine) as CommandLine, count(Details) as Details, count(EventCode) as EventCode, count(GrantedAccess) as GrantedAccess, count(Image) as Image, count(ImagePath) as ImagePath, count(IpAddress) as IpAddress, count(ObjectName) as ObjectName, count(ObjectType) as ObjectType, count(OriginalFileName) as OriginalFileName, count(ParentImage) as ParentImage, count(ProcessName) as ProcessName, count(Provider_Name) as Provider_Name, count(ServiceName) as ServiceName, count(SourceImage) as SourceImage, count(Status) as Status, count(SubStatus) as SubStatus, count(SubjectUserName) as SubjectUserName, count(TargetImage) as TargetImage, count(TargetObject) as TargetObject, count(TargetUserName) as TargetUserName, count(TicketEncryptionType) as TicketEncryptionType, count(clientip) as clientip, count(logtype) as logtype, count(method) as method, count(node_id) as node_id, count(src_host) as src_host, count(status) as status, count(uri_path) as uri_path by feed
| eval reads=case(feed=="linux/process_creation", "Image,CommandLine", feed=="opencanary/honeypot", "logtype,node_id,src_host", feed=="process_access", "TargetImage,SourceImage,GrantedAccess", feed=="process_creation", "ParentImage,Image,OriginalFileName,CommandLine", feed=="registry_set", "TargetObject,Details", feed=="webserver", "clientip,method,uri_path,status", feed=="windows/security#1102", "EventCode", feed=="windows/security#4624", "EventCode,TargetUserName", feed=="windows/security#4625", "EventCode,TargetUserName,SubStatus,IpAddress", feed=="windows/security#4663", "EventCode,ObjectType,ObjectName,AccessList,SubjectUserName,ProcessName", feed=="windows/security#4768", "EventCode,TargetUserName,Status,IpAddress", feed=="windows/security#4769", "EventCode,ServiceName,TicketEncryptionType,Status,IpAddress", feed=="windows/security#4771", "EventCode,TargetUserName,Status,IpAddress", feed=="windows/security#4776", "EventCode,TargetUserName", feed=="windows/system#104", "EventCode,Provider_Name", feed=="windows/system#7045", "EventCode,Provider_Name,ServiceName,ImagePath")
| foreach AccessList CommandLine Details EventCode GrantedAccess Image ImagePath IpAddress ObjectName ObjectType OriginalFileName ParentImage ProcessName Provider_Name ServiceName SourceImage Status SubStatus SubjectUserName TargetImage TargetObject TargetUserName TicketEncryptionType clientip logtype method node_id src_host status uri_path [eval low=if(like("," . reads . ",", "%,<<FIELD>>,%") AND '<<FIELD>>' < 0.95 * events, mvappend(low, "<<FIELD>> " . round(100 * '<<FIELD>>' / events) . "%"), low)]
| where isnotnull(low)
| eval blinds=case(feed=="linux/process_creation", "T1053.003_crontab_noninteractive_install, T1059.004_linux_suspicious_shell_execution", feed=="opencanary/honeypot", "T1046_decoy_service_interaction", feed=="process_access", "T1003.001_lsass_memory_access", feed=="process_creation", "T1021.006_wsmprovhost_suspicious_child, T1053.005_powershell_scheduled_task_creation, T1053.005_schtasks_suspicious_creation, T1059.001_powershell_encoded_command, T1218.011_rundll32_suspicious_execution, T1685.005_event_log_clearing", feed=="registry_set", "T1547.001_registry_run_key_persistence", feed=="webserver", "T1190_object_id_enumeration, T1595.003_api_auth_probing", feed=="windows/security#1102", "T1685.005_security_log_cleared", feed=="windows/security#4624", "T1078.002_honey_account_authentication", feed=="windows/security#4625", "T1078.002_honey_account_authentication, T1110.003_password_spray_burst", feed=="windows/security#4663", "T1552.001_honey_file_access", feed=="windows/security#4768", "T1078.002_honey_account_authentication, T1110.003_password_spray_burst", feed=="windows/security#4769", "T1558.003_honey_spn_ticket_request, T1558.003_kerberoasting_rc4_tgs, T1558.003_kerberoasting_volume", feed=="windows/security#4771", "T1078.002_honey_account_authentication, T1110.003_password_spray_burst", feed=="windows/security#4776", "T1078.002_honey_account_authentication", feed=="windows/system#104", "T1685.005_system_log_cleared", feed=="windows/system#7045", "T1569.002_suspicious_service_installation")
| table feed, events, low, blinds
